# Copia este archivo como .env y completa los valores.

# Puerto donde corre la API
PORT=3001

# Cadena de conexión de MongoDB (local o MongoDB Atlas)
MONGO_URI=mongodb://localhost:27017/character-clash

# Orígenes que pueden llamar a la API, separados por coma
CORS_ORIGIN=http://localhost:5173

# Opcional: token de https://superheroapi.com para incluir superhéroes.
# Si lo dejas vacío, la API usa solo los otros tres universos.
SUPERHERO_API_KEY=

# Opcional: API de Naruto (por defecto, Dattebayo API)
NARUTO_API_URL=https://dattebayo-api.onrender.com
